# Copie para .env e ajuste. Em uso local nada aqui e obrigatorio.

# Banco. Vazio = SQLite em instance/wms.db. Em producao, a URL do Postgres:
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
DATABASE_URL=

# Chave da sessao. Vazio = gerada automaticamente em instance/secret_key (so para uso local).
SECRET_KEY=

# Senha do usuario "admin" criado no primeiro start. Vazio = "admin", com troca obrigatoria no primeiro acesso.
ADMIN_PASSWORD=

# Em producao com HTTPS, use 1.
SESSION_COOKIE_SECURE=

# PDF oficial da nota fiscal (DANFE) pelo Meu Danfe, a partir do XML da nota. Vazio = o sistema gera um espelho proprio.
# Com a chave preenchida, o XML da nota e enviado para a API do Meu Danfe quando alguem abre o PDF.
MEU_DANFE_API_KEY=
# Nota sem XML guardado: 1 = o Meu Danfe busca a nota na Receita pela chave de acesso (R$ 0,03 por nota, uma vez).
# Vazio = so o caminho gratis (converter o XML); nota sem XML abre o espelho ate o XML ser anexado.
MEU_DANFE_BUSCAR_POR_CHAVE=

PORT=5002

# Avisos de falha para o Doca Livre Control Center (opcional; sem estas variaveis fica desligado).
# Cada erro 5xx ou queda do servidor vira alerta no WhatsApp, com usuario, tela, acao e risco.
# DOCA_CC_URL=https://doca-livre-control-center.onrender.com/api
# DOCA_CC_SYSTEM_SLUG=wms
# DOCA_CC_SYSTEM_NAME=WMS Doca Livre
# DOCA_CC_WEBHOOK_SECRET=<mesmo valor de WEBHOOK_SECRET_WMS no Control Center>
